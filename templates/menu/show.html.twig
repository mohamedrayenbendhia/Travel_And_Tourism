{% extends 'base.html.twig' %}

{% block title %}Menu{% endblock %}

{% block body %}
    <h1 class="mb-4">Menu</h1>
    <div class="card p-4 shadow-lg rounded">
        <table class="table table-striped table-bordered">
            <tbody>
                <tr>
                    <th>Id</th>
                    <td>{{ menu.id }}</td>
                </tr>
                <tr>
                    <th>Plat</th>
                    <td>{{ menu.plat }}</td>
                </tr>
                <tr>
                    <th>Prix</th>
                    <td>{{ menu.prix }}</td>
                </tr>
                <tr>
                    <th>Disponibilite</th>
                    <td>{{ menu.disponibilite ? 'Yes' : 'No' }}</td>
                </tr>
            </tbody>
        </table>
    </div>

    <a href="{{ path('app_menu_index') }}" class="btn btn-secondary">back to list</a>
    <a href="{{ path('app_menu_edit', {'id': menu.id}) }}" class="btn btn-warning">edit</a>

    {# Masquer le bouton "Delete" avec display: none; #}
    <form method="post" action="{{ path('app_menu_delete', {'id': menu.id}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');" style="display: none;">
        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ menu.id) }}">
        <button class="btn btn-danger">Delete</button>
    </form>
{% endblock %}