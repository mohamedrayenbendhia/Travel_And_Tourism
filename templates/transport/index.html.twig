{% extends 'base.html.twig' %}

{% block title %}Liste des Transports{% endblock %}

{% block body %}
<div class="site-blocks-cover inner-page-cover overlay" style="background-image: url({{ asset('assets/images/CarBg.webp') }});">
    <div class="container">
        <div class="row align-items-center justify-content-center text-center">
            <div class="col-md-10">
                <h1 class="mb-2">Liste des Transports</h1>
            </div>
        </div>
    </div>
</div>

<div class="container">
    <div class="row">
        <form class="form-search col-md-12" style="margin-top: -100px;" method="GET" action="{{ path('app_transport_index') }}">
            <div class="row align-items-end">
                <div class="col-md-9">
                    <label for="type">Type</label>
                    <input type="text" name="type" class="form-control d-block rounded-0" value="{{ app.request.query.get('type', '') }}">
                </div>
                <div class="col-md-3">
                    <input type="submit" class="btn btn-success text-white btn-block rounded-0" value="Rechercher">
                </div>
            </div>
        </form>
    </div>
</div>

{% if not is_granted('ROLE_ADMIN') and not is_granted('ROLE_TRANSPORTEUR') %}
    <!-- ✅ Public Users View -->
    <div class="site-section">
        <div class="container">
            <div class="row">
                {% if transports is not empty %}
                    {% for transport in transports %}
                        <div class="col-md-6 col-lg-4 mb-4">
                            <a href="{{ path('app_transport_show', {'id': transport.id}) }}" class="btn btn-primary btn-sm">
                                {% if transport.image %}
                                    <img src="{{ asset('uploads/transports/' ~ transport.image) }}" 
                                        alt="{{ transport.type }}"
                                        class="img-fluid"
                                        style="width: 300px; height: 200px; object-fit: cover;">
                                {% else %}
                                    No image available
                                {% endif %}
                            </a>
                            <div class="p-4 bg-white">
                                <span class="d-block text-secondary small text-uppercase">{{ transport.prix }} DT</span>
                                <h2 class="h5 text-black mb-3"><a href="{{ path('app_transport_show', {'id': transport.id}) }}">{{ transport.type }}</a></h2>
                                <p>
                                    {% if transport.isAvailable %}
                                        <span class="badge badge-success">Disponible</span>
                                    {% else %}
                                        <span class="badge badge-danger">Non disponible</span>
                                    {% endif %}
                                </p>
                                <p>{{ transport.description }}</p>
                            </div>
                        </div>
                    {% endfor %}
                {% else %}
                    <div class="col-12 text-center mt-5">
                        <div class="alert alert-warning p-4 shadow-lg rounded">
                            <h4 class="mb-3"><i class="fas fa-exclamation-circle"></i> Aucun résultat trouvé</h4>
                            <p class="text-muted">Essayez de modifier vos critères de recherche.</p>
                            <a href="{{ path('app_transport_index') }}" class="btn btn-primary">Réinitialiser</a>
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>

{% else %}
    <!-- ✅ Admins & Transport Owners View -->
    <div class="card p-4 m-4 shadow-lg rounded">
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>Type</th>
                    <th>Description</th>
                    <th>Prix</th>
                    <th>Disponibilité</th>
                    <th>Image</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for transport in transports %}
                    <tr>
                        <td>{{ transport.type }}</td>
                        <td>{{ transport.description }}</td>
                        <td>{{ transport.prix }}</td>
                        <td>
                            {% if transport.isAvailable %}
                                <span class="badge badge-success">Disponible</span>
                            {% else %}
                                <span class="badge badge-danger">Non disponible</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if transport.image %}
                                <img src="{{ asset('uploads/transports/' ~ transport.image) }}" 
                                    alt="{{ transport.image }}" width="40" class="img-thumbnail">
                            {% else %}
                                No image available
                            {% endif %}
                        </td>
                        <td>
                            <a href="{{ path('app_transport_show', {'id': transport.id}) }}" class="btn btn-primary btn-sm">Show</a>

                            {% if is_granted('ROLE_ADMIN') or (is_granted('ROLE_TRANSPORTEUR') and transport.user == app.user) %}
                                <a href="{{ path('app_transport_edit', {'id': transport.id}) }}" class="btn btn-warning btn-sm">Edit</a>

                                <form action="{{ path('app_transport_delete', {'id': transport.id}) }}" method="post" style="display: inline;">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ transport.id) }}">
                                    <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Êtes-vous sûr de vouloir supprimer ce transport ?');">Delete</button>
                                </form>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="text-center">Aucun transport trouvé.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {% if is_granted('ROLE_TRANSPORTEUR') %}
        <a href="{{ path('app_transport_new') }}" class="m-4 btn btn-success mt-2">Créer un nouveau transport</a>
    {% endif %}
{% endif %}
{% endblock %}
