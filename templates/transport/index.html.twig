{% extends 'base.html.twig' %}

{% block title %}Transport index{% endblock %}

{% block body %}
<div class="site-blocks-cover inner-page-cover overlay" style="background-image: url({{ asset('assets/images/background.jpg') }});">
      <div class="container">
        <div class="row align-items-center justify-content-center text-center">
          <div class="col-md-10">
            <h1 class="mb-2">Liste des Transports</h1>
          </div>
        </div>
      </div>
    </div>

{%  if not isAdmin %}
    <div class="site-section">
      <div class="container">
        <div class="row">
          {% for transport in transports %}
            <div class="col-md-6 col-lg-4 mb-4">
                <a href="#">
                {% if transport.image %}
                  <a href="{{ path('app_transport_new', {'id': transport.id}) }}" class="btn btn-primary btn-sm">

                    <img
                      src="{{ asset('uploads/transports/' ~ transport.image) }}" 
                      alt="transport.type"
                      class="img-fluid"
                      style="width: 300px; height: 200px; object-fit: cover;"
                    >
                    </a>

                {% else %}
                    No image available
                {% endif %}
                </a>
                <div class="p-4 bg-white">
                <span class="d-block text-secondary small text-uppercase">{{ transport.prix }}</span>
                <h2 class="h5 text-black mb-3"><a href="#">{{ transport.type }}</a></h2>
                <p>{{ transport.description }} + description </p>
                </td>
                </div>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>

{% else %}
<div class="card p-4 shadow-lg rounded">
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Id</th>
                <th>Type</th>
                <th>Description</th>
                <th>Prix</th>
                <th>Disponibilte</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for transport in transports %}
            <tr>
                <td>{{ transport.id }}</td>
                <td>{{ transport.type }}</td>
                <td>{{ transport.description }}</td>
                <td>{{ transport.prix }}</td>
                <td>{{ transport.disponibilte }}</td>
                  <td>
                        {% if transport.image %}
                            <img src="{{ asset('uploads/transports/' ~  transport.image) }}" 
                                 alt="{{ transport.image}}" width=40 class="img-thumbnail">
                        {% else %}
                            No image available
                        {% endif %}
                    </td>
                <td>
                    <a href="{{ path('app_transport_show', {'id': transport.id}) }}" class="btn btn-primary btn-sm">show</a>
                    <a href="{{ path('app_transport_edit', {'id': transport.id}) }}" class="btn btn-warning btn-sm">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6" class="text-center">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

</div>
    <a href="{{ path('app_transport_new') }}" class="btn btn-success mt-2">Create new</a>
    {% endif %}
{% endblock %}
