{% extends 'base.html.twig' %}

{% block title %}Transport{% endblock %}

{% block body %}
    <h1 class="mb-4">Transport</h1>

<div class="card p-4 shadow-lg rounded">
        <table class="table table-striped table-bordered">
            <tbody>
                <tr>
                    <th>Id</th>
                    <td>{{ transport.id }}</td>
                </tr>
                <tr>
                    <th>Type</th>
                    <td>{{ transport.type }}</td>
                </tr>
                <tr>
                    <th>Description</th>
                    <td>{{ transport.description }}</td>
                </tr>
                <tr>
                    <th>Disponibilte</th>
                    <td>{{ transport.disponibilte }}</td>
                </tr>
                <tr>
                    <th>Prix</th>
                    <td>{{ transport.prix }}</td>
                </tr>
                <tr>
                    <th>Image</th>
                    <td>
                        {% if transport.image %}
                            <img src="{{ asset('uploads/transports/' ~ transport.image) }}" 
                                 alt="{{ transport.nom }}" width="200" class="img-thumbnail">
                        {% else %}
                            No image available
                        {% endif %}
                    </td>
                </tr>
            </tbody>
        </table>
    </div>


<a href="{{ path('app_restaurant_index') }}" class="btn btn-secondary">Back to List</a>
{% if isAdmin %}
    <a href="{{ path('app_restaurant_edit', {'id': restaurant.id}) }}" class="btn btn-warning">Edit</a>

    <a href="{{ path('app_transport_new') }}" class="btn btn-success mt-3">Ajouter un transport</a>
{% endif %}
{% endblock %}
