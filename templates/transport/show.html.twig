{% extends 'base.html.twig' %}

{% block title %}Transport{% endblock %}

{% block body %}
<div class="site-blocks-cover inner-page-cover overlay" style="background-image: url({{ asset('assets/images/CarBg.webp') }});">
    <div class="container">
        <div class="row align-items-center justify-content-center text-center">
            <div class="col-md-10">
                <h1 class="mb-2">
                    {{ transport.type }}
                </h1>
            </div>
        </div>
    </div>
</div>
<div class="site-section site-section-sm mt-4">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div>
                    <div class="slide-one-item home-slider owl-carousel">
                        <img src="{{ asset('uploads/transports/' ~ transport.image) }}" 
                             alt="{{ transport.type }}" class="img-fluid w-100">
                    </div>
                </div>
                <div class="bg-white property-body border-bottom border-left border-right">
                    <div class="row mb-5">
                        <div class="col-md-6 col-lg-6 text-center border-bottom border-top py-3">
                            <span class="d-inline-block text-black mb-0 caption-text">Type</span>
                            <strong class="d-block">{{ transport.type }}</strong>
                        </div>
                        <div class="col-md-6 col-lg-6 text-center border-bottom border-top py-3">
                            <span class="d-inline-block text-black mb-0 caption-text">Prix</span>
                            <strong class="d-block">{{ transport.prix }} DT</strong>
                        </div>
                    </div>
                    <h2 class="h4 text-black">Description</h2>
                    <p>{{ transport.description }}</p>

                    {% if reservations %}
                        <h2 class="mt-4 h4 text-black">Période d'indisponibilité</h2>
                        <ul class="list-group" id="unavailability-list">
                            {% for reservation in reservations %}
                                <li class="list-group-item">
                                    De <span class="unavailable-start">{{ reservation.start_date|date('Y-m-d') }}</span>
                                    à <span class="unavailable-end">{{ reservation.end_date|date('Y-m-d') }}</span>
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}

                    <!-- Reservation Form -->
                  {% if is_granted('ROLE_VOYAGEUR') or is_granted('ROLE_HOTE') %}

                    <h2 class="h4 text-black mt-4">Réserver cette voiture </h2>
                    <form id="reservation-form">
                        <div class="form-group">
                            <label for="start_date">Date début</label>
                            <input type="date" id="start_date" name="start_date" class="form-control" required>
                        </div>
                        <div class="form-group">
                            <label for="end_date">Date fin</label>
                            <input type="date" id="end_date" name="end_date" class="form-control" required>
                        </div>
                        <button type="submit" id="reserve-btn" class="btn btn-primary mt-3">Réserver</button>
                    </form>

                    <button id="download-invoice" class="btn btn-success mt-3" style="display: none;">
    Télécharger la facture
</button>
{% endif %}

                    
                </div>
            </div>
        </div>
    </div>
</div>

<a href="{{ path('app_transport_index') }}" class="btn btn-secondary">Back to List</a>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script>
document.addEventListener("DOMContentLoaded", function () {
    const { jsPDF } = window.jspdf;

    const reservations = [];
    document.querySelectorAll("#unavailability-list li").forEach(item => {
        const start = new Date(item.querySelector(".unavailable-start").innerText);
        const end = new Date(item.querySelector(".unavailable-end").innerText);
        reservations.push({ start, end });
    });

    const startDateInput = document.getElementById("start_date");
    const endDateInput = document.getElementById("end_date");
    const reserveBtn = document.getElementById("reserve-btn");
    const downloadBtn = document.getElementById("download-invoice");
    const messageDiv = document.createElement("div"); 
    messageDiv.style.color = "red";
    messageDiv.style.marginTop = "10px";
    reserveBtn.insertAdjacentElement("beforebegin", messageDiv);

    function checkAvailability() {
        const startDate = new Date(startDateInput.value);
        const endDate = new Date(endDateInput.value);

        let isUnavailable = false;
        reservations.forEach(res => {
            if ((startDate >= res.start && startDate <= res.end) || 
                (endDate >= res.start && endDate <= res.end) || 
                (startDate <= res.start && endDate >= res.end)) {
                isUnavailable = true;
            }
        });

        if (isUnavailable) {
            reserveBtn.disabled = true;
            messageDiv.innerText = "The car is not available during this period.";
        } else {
            reserveBtn.disabled = false;
            messageDiv.innerText = "";
        }
    }

    startDateInput.addEventListener("change", checkAvailability);
    endDateInput.addEventListener("change", checkAvailability);

    document.getElementById("reservation-form").addEventListener("submit", function (event) {
        event.preventDefault();
        if (reserveBtn.disabled) return;

        const transportId = "{{ transport.id }}";
        const startDate = startDateInput.value;
        const endDate = endDateInput.value;

        fetch("{{ path('app_reservation_transport_new_res') }}", {
            method: "POST",
            headers: {
                "Content-Type": "application/json",
                "X-CSRF-Token": "{{ csrf_token('create_reservation') }}"
            },
            body: JSON.stringify({
                user_id: "{% if app.user %} {{ app.user.id }} {% else %} 0 {% endif %}",
                transport_id: transportId,
                start_date: startDate,
                end_date: endDate,
                statut: "confirmed"
            })
        }).then(response => response.json())
        .then(data => {
            if (data.message === "Reservation created successfully") {
                alert("Réussi! Votre réservation a été créée avec succès.");

                // Show the "Download Invoice" button
                downloadBtn.style.display = "block";

                // Append the new reservation to the unavailability list
                const unavailabilityList = document.getElementById("unavailability-list");
                if (!unavailabilityList) return;

                const newItem = document.createElement("li");
                newItem.classList.add("list-group-item");
                newItem.innerHTML = `De <span class="unavailable-start">${startDate}</span>
                                    à <span class="unavailable-end">${endDate}</span>`;
                unavailabilityList.appendChild(newItem);

                // Update reservations array to prevent new conflicts
                reservations.push({ 
                    start: new Date(startDate), 
                    end: new Date(endDate) 
                });

                // Clear form fields
     
            } else {
                alert("Error creating reservation.");
            }
        }).catch(error => console.error("Error:", error));
    });

    // Generate the PDF invoice when clicking "Download Invoice"
    downloadBtn.addEventListener("click", function () {
        const pdf = new jsPDF();

        // Reservation details
        const userName = "John Doe"; // Replace with actual user name logic
        const transportType = "{{ transport.type }}";
        const price = "{{ transport.prix }} DT";
        const startDate = startDateInput.value || "N/A";
        const endDate = endDateInput.value || "N/A";

        pdf.setFontSize(22);
        pdf.text("Facture de réservation de voiture", 20, 20);
        pdf.setFontSize(12);
        pdf.text(`Client: ${userName}`, 20, 40);
        pdf.text(`Type de voirture: ${transportType}`, 20, 50);
        pdf.text(`Date début: ${startDate.toString()}`, 20, 60);
        pdf.text(`Date fin: ${endDate.toString()}`, 20, 70);
        pdf.text(`Price: ${price}`, 20, 80);
        pdf.text(`Statut: Confirmé`, 20, 90);

        // Footer
        pdf.setFontSize(10);
        pdf.text("Merci d'avoir choisi notre service de réservation de transport.", 20, 280);

        // Save and download
        pdf.save("invoice.pdf");
    });
});
</script>



{% endblock %}
