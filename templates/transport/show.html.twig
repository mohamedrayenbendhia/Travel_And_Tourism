{% extends 'base.html.twig' %}

{% block title %}Transport{% endblock %}

{% block body %}
    <h1 class="mb-4">Transports</h1>

    <div class="row">
        {% for transport in transports %}
            <div class="col-md-4">
                <div class="card p-3 shadow-lg rounded">
                    {% if transport.image %}
                        <img src="{{ asset('uploads/transports/' ~ transport.image) }}" class="card-img-top" alt="Transport Image">
                    {% else %}
                        <img src="{{ asset('uploads/default.png') }}" class="card-img-top" alt="Default Image">
                    {% endif %}

                    <div class="card-body">
                        <h5 class="card-title">{{ transport.type }}</h5>
                        <p class="card-text">{{ transport.description }}</p>
                        <p><strong>Prix :</strong> {{ transport.prix }} TND</p>
                        <p><strong>Disponibilité :</strong> {{ transport.disponibilte ? 'Oui' : 'Non' }}</p>

                        <a href="{{ path('app_transport_show', {'id': transport.id}) }}" class="btn btn-primary">Voir plus</a>
                        <a href="{{ path('app_transport_edit', {'id': transport.id}) }}" class="btn btn-warning">Modifier</a>
                    </div>
                </div>
            </div>
        {% else %}
            <p>Aucun transport disponible.</p>
        {% endfor %}
    </div>

    <a href="{{ path('app_transport_new') }}" class="btn btn-success mt-3">Ajouter un transport</a>
{% endblock %}
