{% extends 'base.html.twig' %}

{% block title %}New Transport{% endblock %}



{% block body %}
<div class="site-blocks-cover inner-page-cover overlay" style="background-image: url({{ asset('assets/images/CarBg.webp') }});">
    <div class="container">
        <div class="row align-items-center justify-content-center text-center">
            <div class="col-md-10">
                <h1 class="mb-2">
                    Créer un nouveau transport
                </h1>
            </div>
        </div>
    </div>
</div>

<div class="container mb-4">
    <div class="form-container">
        <div class="mb-3 mt-3">
            {{ include('transport/_form.html.twig') }}
        </div>
        <div class="text-center">
            <a href="{{ path('app_transport_index') }}" class="btn-custom">Back to List</a>
        </div>
    </div>
</div>
{% endblock %}
