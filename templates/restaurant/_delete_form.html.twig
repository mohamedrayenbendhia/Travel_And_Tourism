{# templates/restaurant/_delete_form.html.twig #}

<form method="post" action="{{ path('app_restaurant_delete', {'id': restaurant.id}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');" class="d-inline">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ restaurant.id) }}">
    <button class="btn btn-danger">
        <i class="fas fa-trash-alt"></i> Delete
    </button>
</form>