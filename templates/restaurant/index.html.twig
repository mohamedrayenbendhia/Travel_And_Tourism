{% extends 'base.html.twig' %}

{% block title %}Restaurant index{% endblock %}

{% block body %}
    <div class="site-blocks-cover inner-page-cover overlay" style="background-image: url({{ asset("../assets/images/hero_bg_2.jpg")}});">
      <div class="container">
        <div class="row align-items-center justify-content-center text-center">
          <div class="col-md-10">
            <h1 class="mb-2">Liste des Restaurants</h1>
          </div>
        </div>
      </div>
    </div>

{% if not isAdmin %}
    <div class="site-section">
      <div class="container">
        {%  if isAdmin %}
        <div class="row">
          <div class="col mb-4"> 
            <a href="{{ path('app_restaurant_new') }}" class="btn btn-success mt-2">Create new</a>
          </div>
        </div> 
         {% endif %}

        <div class="row">
          {% for restaurant in restaurants %}
            <div class="col-md-6 col-lg-4 mb-4">
                <a href="#">
                {% if restaurant.image %}
                  <a href="{{ path('app_restaurant_show', {'id': restaurant.id}) }}" class="btn btn-primary btn-sm">

                    <img
                      src="{{ asset('uploads/restaurants/' ~ restaurant.image) }}" 
                      alt="{{ restaurant.nom }}"
                      class="img-fluid"
                      style="width: 300px; height: 200px; object-fit: cover;"
                    >
                    </a>

                {% else %}
                    No image available
                {% endif %}
                </a>
                <div class="p-4 bg-white">
                <span class="d-block text-secondary small text-uppercase">{{ restaurant.localisation }}</span>
                <h2 class="h5 text-black mb-3"><a href="#">{{ restaurant.nom }}</a></h2>
                <p>{{ restaurant.nom }} + Profitez de réductions exclusives et de promotions dans les restaurants tunisiens.</p>
                </td>
                </div>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>

    {% else %}
      <div class="card p-4 shadow-lg rounded">
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nom</th>
                <th>Localisation</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for restaurant in restaurants %}
            <tr>
                <td>{{ restaurant.id }}</td>
                <td>{{ restaurant.nom }}</td>
                <td>{{ restaurant.localisation }}</td>
                  <td>
                        {% if restaurant.image %}
                            <img src="{{ asset('uploads/restaurants/' ~ restaurant.image) }}" 
                                 alt="{{ restaurant.nom }}" width=40 class="img-thumbnail">
                        {% else %}
                            No image available
                        {% endif %}
                    </td>
                </tr>
                <td>
                    <a href="{{ path('app_restaurant_show', {'id': restaurant.id}) }}" class="btn btn-primary btn-sm">show</a>
                    <a href="{{ path('app_restaurant_edit', {'id': restaurant.id}) }}" class="btn btn-warning btn-sm">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4" class="text-center">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
    <a href="{{ path('app_restaurant_new') }}" class="btn btn-success mt-2">Create new</a>
    {% endif %}

{% endblock %}
