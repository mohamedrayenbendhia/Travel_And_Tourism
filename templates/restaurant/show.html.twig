                     <div class="col-lg-12 command-form">
            <div class="card container mt-4">
                <div class="card-body">
                    <h4 class="text-black">Passer une Commande</h4>
                          <form id="reservation-form">
                        <div class="form-group">
                            <label for="date_commande">Date commande</label>
                            <input type="datetime-local" id="date_commande" name="date_commande" class="form-control" required>
                        </div>
