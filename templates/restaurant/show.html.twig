<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="https://unpkg.com/leaflet-routing-machine/dist/leaflet-routing-machine.js"></script>
<script>
document.addEventListener("DOMContentLoaded", function () {
    var restaurantLat = {{ restaurant.lat|default(35.6895) }};
    var restaurantLng = {{ restaurant.lng|default(10.1234) }};

    var map = L.map('map', {
        center: [restaurantLat, restaurantLng],
        zoom: 14,
        scrollWheelZoom: false,
    });

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; OpenStreetMap contributors'
    }).addTo(map);

    var restaurantMarker = L.marker([restaurantLat, restaurantLng]).addTo(map)
        .bindPopup("<b>{{ restaurant.nom }}</b><br>{{ restaurant.localisation }}")
        .openPopup();

    var routingControl;

    function showRoute(position) {
        var userLat = position.coords.latitude;
        var userLng = position.coords.longitude;

        var userMarker = L.marker([userLat, userLng], {icon: L.icon({
            iconUrl: 'https://leafletjs.com/examples/custom-icons/leaf-red.png',
            iconSize: [38, 38]
        })}).addTo(map).bindPopup("Your Location").openPopup();

      

        if (typeof L.Routing !== "undefined") {
            if (routingControl) {
                map.removeControl(routingControl); // Remove previous route if exists
            }

            routingControl = L.Routing.control({
                waypoints: [
                    L.latLng(userLat, userLng),
                    L.latLng(restaurantLat, restaurantLng)
                ],
                routeWhileDragging: true,
                createMarker: function() { 
                    return L
                 },
                show: false,
                addWaypoints: false,
                fitSelectedRoutes: true,
                lineOptions: {
                    styles: [{ color: 'red', opacity: 0.7, weight: 4, dashArray: '10, 10' }]
                }
            }).addTo(map);

            // Add Estimated Time Display
            var durationDiv = document.getElementById("route-duration");
            var routeDisplay = document.querySelector(".route-display");
            if (!durationDiv) {
                durationDiv = document.getElementById("route-duration");
             
                durationDiv.innerText = "Calculating travel time...";
                routeDisplay.appendChild(durationDiv);
            }

            routingControl.on('routesfound', function(e) {
                var duration = e.routes[0].summary.totalTime;
                durationDisplay = "Estimated Travel Time: " + Math.round(duration / 60) + " mins";
                durationDiv.innerText = durationDisplay;
                  var tooltip = L.tooltip({ direction: 'bottom' })
    .setLatLng([userLat, userLng])
    .setContent(durationDisplay)
    .addTo(map);

            });
        } else {
            console.error("Leaflet Routing Machine is not available!");
        }
    }

    function handleLocationError(error) {
        console.error("Error getting location: " + error.message);
        alert("Could not get your location. Please enable location services.");
    }

    if (navigator.geolocation) {
        navigator.geolocation.getCurrentPosition(showRoute, handleLocationError);
    } else {
        alert("Geolocation is not supported by this browser.");
    }

    setTimeout(() => map.invalidateSize(), 300);

    // Form Submission Handling
    document.getElementById("reservation-form").addEventListener("submit", function (event) {
        event.preventDefault();

        fetch("{{ path('app_commande_new_res') }}", {
            method: "POST",
            headers: {
                "Content-Type": "application/json",
                "X-CSRF-Token": "{{ csrf_token('create_commande') }}"
            },
            body: JSON.stringify({
                restaurant_id: {{ restaurant.id }},
                date_commande: document.getElementById("date_commande").value,
                statut: document.getElementById("statut").value,
                user_id: 1
            })
        }).then(response => {
            if (response.ok) {
                alert("Commande successful!");
                window.location.reload();
            } else {
                alert("Error creating commande.");
            }
        }).catch(error => console.error("Error:", error));
    });
});
</script>


