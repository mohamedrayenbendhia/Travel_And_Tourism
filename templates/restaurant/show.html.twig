{% extends 'base.html.twig' %}

{% block title %}Restaurant{% endblock %}

{% block stylesheets %}
    {{ parent() }} {# Ensures base styles are included first #}
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <style>
        /* Fix Map Styling Without Affecting Other Styles */
        #map {
            height: 400px; /* Set height for the map */
            width: 100%;
            border-radius: 8px;
            margin-top: 20px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
            z-index: 1; /* Ensure it does not interfere with content */
        }

        /* Fix Leaflet Container */
        .leaflet-container {
            border-radius: 8px;
            z-index: 0 !important;
        }

        /* Prevent Leaflet from breaking the layout */
        .leaflet-top, .leaflet-bottom {
            z-index: 1000 !important;
        }

        /* Fix overlapping UI elements */
        .leaflet-control {
            z-index: 1001 !important;
        }
        .leaflet-routing-container {
    display: none !important;
}

    #route-duration {
        padding: 10px;
        margin-top: 10px;
        margin-right: 10px;
        font-size: 16px;
        font-weight: bold;
        color: #333;
        position: absolute;
        top: 0;
        right: 0;
        z-index: 1000;
        background-color: rgba(255, 255, 255, 0.8);
        
    }

    .route-display {
        position: relative;
    }



    </style>
{% endblock %}


{% block body %}

