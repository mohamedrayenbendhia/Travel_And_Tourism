{% extends 'base.html.twig' %}

{% block title %}Restaurant{% endblock %}

{% block body %}
    <h1 class="mb-4">Restaurant</h1>
    <div class="card p-4 shadow-lg rounded">
        <table class="table table-striped table-bordered">
            <tbody>
                <tr>
                    <th>Id</th>
                    <td>{{ restaurant.id }}</td>
                </tr>
                <tr>
                    <th>Nom</th>
                    <td>{{ restaurant.nom }}</td>
                </tr>
                <tr>
                    <th>Localisation</th>
                    <td>{{ restaurant.localisation }}</td>
                </tr>
                <tr>
                    <th>Image</th>
                    <td>
                        {% if restaurant.image %}
                            <img src="{{ asset('uploads/restaurants/' ~ restaurant.image) }}" 
                                 alt="{{ restaurant.nom }}" width="200" class="img-thumbnail">
                        {% else %}
                            No image available
                        {% endif %}
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <a href="{{ path('app_restaurant_index') }}" class="btn btn-secondary">Back to List</a>

    <a href="{{ path('app_restaurant_edit', {'id': restaurant.id}) }}" class="btn btn-warning">Edit</a>

    {{ include('restaurant/_delete_form.html.twig') }}
{% endblock %}
