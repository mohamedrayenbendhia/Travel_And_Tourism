{% extends 'base.html.twig' %}

{% block body %}
<div class="container mt-5">
    <div class="card shadow-lg border-0 rounded-4 p-4" style="max-width: 600px; margin: auto; background: linear-gradient(135deg, #f8f9fa, #e9ecef);">
        <div class="text-center">
            <i class="fas fa-user-edit fa-4x text-primary mb-3"></i>
            <h2 class="fw-bold text-dark">Modifier mon profil</h2>
        </div>
        <hr class="my-4">
        <div class="px-3">
            {{ form_start(form) }}
                <div class="mb-3">
                    {{ form_label(form.username, 'Nom d’utilisateur', {'label_attr': {'class': 'fw-bold text-secondary'}}) }}
                    {{ form_widget(form.username, {'attr': {'class': 'form-control shadow-sm'}}) }}
                </div>

                <div class="mb-3">
                    {{ form_label(form.email, 'Email', {'label_attr': {'class': 'fw-bold text-secondary'}}) }}
                    {{ form_widget(form.email, {'attr': {'class': 'form-control shadow-sm'}}) }}
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a href="{{ path('app_profile') }}" class="btn btn-secondary w-45">
                        <i class="fas fa-arrow-left"></i> Annuler
                    </a>
                    <button type="submit" class="btn btn-success w-45">
                        <i class="fas fa-save"></i> Enregistrer
                    </button>
                </div>
            {{ form_end(form, {'render_rest': false}) }}
        </div>
    </div>
</div>
{% endblock %}
