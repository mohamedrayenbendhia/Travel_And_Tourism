{% extends 'base.html.twig' %}

{% block title %}Edit Profile - {% endblock %}

{% block stylesheets %}
<style>
    .profile-section {
        min-height: 80vh;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        padding: 3rem 0;
    }
    
    .profile-card {
        background: white;
        border-radius: 15px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        overflow: hidden;
        transition: all 0.3s ease;
    }

    .profile-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.15);
    }

    .profile-header {
        background: linear-gradient(45deg, #2193b0, #6dd5ed);
        padding: 2rem;
        color: white;
        text-align: center;
    }

    .profile-avatar {
        width: 100px;
        height: 100px;
        background: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.5rem;
        font-weight: bold;
        color: #2193b0;
        margin: 0 auto 1rem;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
    }

    .profile-body {
        padding: 2rem;
    }

    .form-control {
        border-radius: 8px;
        padding: 12px;
        border: 1px solid #e0e0e0;
        transition: all 0.3s ease;
    }

    .form-control:focus {
        border-color: #2193b0;
        box-shadow: 0 0 0 0.2rem rgba(33, 147, 176, 0.25);
    }

    .form-label {
        font-weight: 600;
        color: #333;
        margin-bottom: 0.5rem;
    }

    .btn-save {
        background: linear-gradient(45deg, #2193b0, #6dd5ed);
        border: none;
        padding: 12px 30px;
        border-radius: 8px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        transition: all 0.3s ease;
    }

    .btn-save:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(33, 147, 176, 0.3);
    }

    .btn-delete {
        background: linear-gradient(45deg, #ff416c, #ff4b2b);
        border: none;
        padding: 12px 30px;
        border-radius: 8px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        transition: all 0.3s ease;
    }

    .btn-delete:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(255, 65, 108, 0.3);
    }

    .delete-section {
        border-top: 1px solid #eee;
        margin-top: 2rem;
        padding-top: 2rem;
    }

    .alert {
        border-radius: 8px;
        border: none;
        margin-bottom: 1.5rem;
    }
</style>
{% endblock %}

{% block body %}
<div class="profile-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="profile-card">
                    <div class="profile-header">
                        <div class="profile-avatar">
                            {% if app.user.profileImage %}
                                <img src="{{ asset('uploads/profile_images/' ~ app.user.profileImage) }}" 
                                     alt="Profile Image" 
                                     class="rounded-circle"
                                     style="width: 100px; height: 100px; object-fit: cover;">
                            {% else %}
                                {{ app.user.username|slice(0, 1)|upper }}
                            {% endif %}
                        </div>
                        <h2 class="mb-0">Edit Profile</h2>
                        <p class="mb-0 text-white-50">Update your personal information</p>
                        <button type="button" class="btn btn-light mt-3" data-bs-toggle="modal" data-bs-target="#qrCodeModal">
                            <i class="bi bi-qr-code me-2"></i>View QR Code
                        </button>
                    </div>

                    <div class="profile-body">
                        {% for message in app.flashes('success') %}
                            <div class="alert alert-success alert-dismissible fade show">
                                {{ message }}
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        {% endfor %}

                        {% for message in app.flashes('error') %}
                            <div class="alert alert-danger alert-dismissible fade show">
                                {{ message }}
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        {% endfor %}

                        {{ form_start(profileForm, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}
                            <div class="mb-4">
                                {{ form_label(profileForm.username, 'Username', {'label_attr': {'class': 'form-label'}}) }}
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-person"></i></span>
                                    {{ form_widget(profileForm.username, {'attr': {'class': 'form-control'}}) }}
                                </div>
                                {{ form_errors(profileForm.username) }}
                            </div>

                            <div class="mb-4">
                                {{ form_label(profileForm.email, 'Email', {'label_attr': {'class': 'form-label'}}) }}
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                    {{ form_widget(profileForm.email, {'attr': {'class': 'form-control'}}) }}
                                </div>
                                {{ form_errors(profileForm.email) }}
                            </div>

                            <div class="mb-4">
                                {{ form_label(profileForm.profileImage, 'Photo de profil', {'label_attr': {'class': 'form-label'}}) }}
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-image"></i></span>
                                    {{ form_widget(profileForm.profileImage, {'attr': {'class': 'form-control', 'accept': 'image/*'}}) }}
                                </div>
                                <small class="form-text text-muted">Formats acceptés : JPG, PNG. Taille maximale : 1MB</small>
                                {{ form_errors(profileForm.profileImage) }}
                                {% if app.user.profileImage %}
                                    <div class="mt-2">
                                        <img src="{{ asset('uploads/profile_images/' ~ app.user.profileImage) }}" 
                                             alt="Current Profile Image" 
                                             class="img-thumbnail"
                                             style="max-width: 150px;">
                                    </div>
                                {% endif %}
                            </div>

                            <div class="mb-4">
                                {{ form_label(profileForm.plainPassword.first, 'New Password (leave empty to keep current)', {'label_attr': {'class': 'form-label'}}) }}
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-lock"></i></span>
                                    {{ form_widget(profileForm.plainPassword.first, {'attr': {'class': 'form-control'}}) }}
                                </div>
                                {{ form_errors(profileForm.plainPassword.first) }}
                            </div>

                            <div class="mb-4">
                                {{ form_label(profileForm.plainPassword.second, 'Confirm New Password', {'label_attr': {'class': 'form-label'}}) }}
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                                    {{ form_widget(profileForm.plainPassword.second, {'attr': {'class': 'form-control'}}) }}
                                </div>
                                {{ form_errors(profileForm.plainPassword.second) }}
                            </div>

                            {{ form_rest(profileForm) }}

                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-primary btn-save">
                                    <i class="bi bi-check-circle me-2"></i>Save Changes
                                </button>
                            </div>
                        {{ form_end(profileForm) }}

                        <div class="delete-section">
                            <h4 class="text-danger mb-4">Delete Account</h4>
                            <p class="text-muted mb-4">Once you delete your account, there is no going back. Please be certain.</p>
                            <form method="POST" action="{{ path('app_delete_account') }}" onsubmit="return confirm('Are you really sure you want to delete your account? This action cannot be undone.');">
                                <button type="submit" class="btn btn-danger btn-delete">
                                    <i class="bi bi-trash me-2"></i>Delete Account
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Account Modal -->
<div class="modal fade" id="deleteAccountModal" tabindex="-1" aria-labelledby="deleteAccountModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-danger" id="deleteAccountModalLabel">Confirm Account Deletion</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete your account? This action cannot be undone.</p>
                <p class="text-danger"><strong>Warning:</strong> All your data will be permanently deleted.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form method="POST" action="{{ path('app_delete_account') }}" class="d-inline">
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash me-2"></i>Delete Account
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- QR Code Modal -->
<div class="modal fade" id="qrCodeModal" tabindex="-1" aria-labelledby="qrCodeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="qrCodeModalLabel">Profile QR Code</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <div class="qr-code-container" style="min-height: 300px; display: flex; align-items: center; justify-content: center;">
                    <div class="qr-loading">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                    <div id="qrCodeDisplay" class="d-none" style="width: 300px; height: 300px;"></div>
                </div>
                <p class="mt-3 text-muted">Scan this QR code to view profile details</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <a href="{{ path('app_profile_qr_code') }}" 
                   download="profile-qr-code.svg" 
                   class="btn btn-primary">
                    <i class="bi bi-download me-2"></i>Download QR Code
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const qrCodeModal = document.getElementById('qrCodeModal');
    const qrCodeDisplay = document.getElementById('qrCodeDisplay');
    const qrLoading = qrCodeModal.querySelector('.qr-loading');

    qrCodeModal.addEventListener('show.bs.modal', function () {
        // Show loading state
        qrCodeDisplay.classList.add('d-none');
        qrLoading.classList.remove('d-none');
        qrLoading.innerHTML = '<div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div>';

        // Load new QR code
        const timestamp = new Date().getTime();
        fetch(`{{ path('app_profile_qr_code') }}?t=${timestamp}`)
            .then(response => {
                if (!response.ok) {
                    throw new Error('Network response was not ok');
                }
                return response.text();
            })
            .then(svg => {
                if (svg.includes('Error generating QR code')) {
                    throw new Error(svg);
                }
                qrCodeDisplay.innerHTML = svg;
                qrCodeDisplay.classList.remove('d-none');
                qrLoading.classList.add('d-none');
            })
            .catch(error => {
                qrLoading.innerHTML = '<div class="text-danger"><i class="bi bi-exclamation-triangle me-2"></i>Error loading QR code</div>';
                console.error('Error:', error);
            });
    });

    // Reset modal content when hidden
    qrCodeModal.addEventListener('hidden.bs.modal', function () {
        qrCodeDisplay.innerHTML = '';
        qrCodeDisplay.classList.add('d-none');
        qrLoading.classList.remove('d-none');
        qrLoading.innerHTML = '<div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div>';
    });
});
</script>
{% endblock %} 