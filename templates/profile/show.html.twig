{% extends 'base.html.twig' %}

{% block body %}
<div class="container mt-5">
    <div class="card shadow-lg border-0 rounded-4 p-4" style="max-width: 600px; margin: auto; background: linear-gradient(135deg, #f8f9fa, #e9ecef);">
        <div class="text-center">
            <i class="fas fa-user-circle fa-5x text-primary mb-3"></i>
            <h2 class="fw-bold text-dark">Mon Profil</h2>
        </div>
        <hr class="my-4">
        <div class="px-3">
            <p class="fs-5"><strong class="text-secondary">Nom d'utilisateur :</strong> <span class="text-dark">{{ user.username }}</span></p>
            <p class="fs-5"><strong class="text-secondary">Email :</strong> <span class="text-dark">{{ user.email }}</span></p>
        </div>
        <div class="d-flex justify-content-between mt-4">
            <a href="{{ path('app_profile_edit') }}" class="btn btn-warning w-45">
                <i class="fas fa-edit"></i> Modifier
            </a>
                      {% if app.user and 'ROLE_VOYAGEUR' in app.user.roles %}

            <a href="{{ path('nos_vlog') }}" class="btn btn-info w-45">
                <i class="fas fa-video"></i> Mes Vlogs

            </a>
                    {% endif %}
        </div>
    </div>
</div>
{% endblock %}
 