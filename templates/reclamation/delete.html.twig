{% extends 'base.html.twig' %}

{% block title %}Supprimer une réclamation{% endblock %}

{% block body %}
    <h1>Êtes-vous sûr de vouloir supprimer cette réclamation ?</h1>

    <form action="{{ path('reclamation_delete', {id: reclamation.id}) }}" method="post">
        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ reclamation.id) }}">
        <button type="submit">Oui, supprimer</button>
        <a href="{{ path('reclamation_index') }}">Non, retourner à la liste</a>
    </form>
{% endblock %}
