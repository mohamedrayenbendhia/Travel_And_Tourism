{% extends 'base.html.twig' %}

{% block body %}
    <h1>Mes Vlogs</h1>

    <a href="{{ path('vlog_new') }}">Créer un nouveau Vlog</a>

    <ul>
        {% for vlog in vlogs %}
            <li>
                <h2>{{ vlog.title }}</h2>
                <p>{{ vlog.content }}</p>

                {% if vlog.author == app.user %}
                    <a href="{{ path('vlog_edit', {'id': vlog.id}) }}">Modifier</a>
                    <form method="post" action="{{ path('vlog_delete', {'id': vlog.id}) }}" onsubmit="return confirm('Êtes-vous sûr ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ vlog.id) }}">
                        <button type="submit">Supprimer</button>
                    </form>
                {% endif %}
            </li>
        {% endfor %}
    </ul>
{% endblock %}
