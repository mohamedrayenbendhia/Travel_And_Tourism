{% extends 'page/index.html.twig' %}

{% block body %}

    <div class="site-section">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-md-8">
                    {{ form_start(form, {'attr': {'class': 'p-4 bg-white shadow rounded', 'enctype': 'multipart/form-data'}}) }}
                        
                        <div class="form-group">
                            <label>Contenu :</label>
                            {{ form_widget(form.content, {'attr': {'class': 'form-control'}}) }}
                        </div>

                        <div class="form-group">
                            <label>Image :</label>
                            {{ form_widget(form.image, {'attr': {'class': 'form-control-file'}}) }}
                        </div>

                        <div class="form-group">
                            <label>Vidéo (URL) :</label>
                            {{ form_widget(form.video, {'attr': {'class': 'form-control'}}) }}
                        </div>

                        <button type="submit" class="btn btn-primary btn-block">
                            {% if vlog.id %}Mettre à jour{% else %}Ajouter{% endif %}
                        </button>
                    
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>

    {% if vlog.createdAt %}
        <div class="form-group">
            <label>Date de création :</label>
            <input type="text" class="form-control" value="{{ vlog.createdAt|date('Y-m-d H:i:s') }}" readonly />
        </div>
    {% endif %}
</div>
{% endblock %}
