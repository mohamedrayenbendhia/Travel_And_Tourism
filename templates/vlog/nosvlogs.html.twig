{% extends 'base.html.twig' %}

{% block stylesheets %}
    <style>
        /* Conteneur principal */
        .site-wrap {
            padding-top: 50px;
            background-color: #f5f5f5;
        }

        .site-section {
            padding: 50px 0;
            background-color: #ffffff;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
        }

        /* Ajouter un vlog bouton */
        .btn-success {
            background-color: #28a745;
            color: white;
            border: none;
            border-radius: 50%;
            width: 50px;
            height: 50px;
            display: flex;
            justify-content: center;
            align-items: center;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
            font-size: 20px;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .btn-success:hover {
            background-color: #218838;
            transform: translateY(-5px);
            box-shadow: 0 6px 15px rgba(0, 0, 0, 0.15);
        }

     

        .col-md-6:hover, .col-lg-4:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.1);
        }

        /* Image */
        .col-md-6 .img-fluid {
            border-radius: 15px;
            width: 100%;
            height: auto;
            transition: transform 0.3s ease, opacity 0.3s ease;
        }

        .col-md-6:hover .img-fluid {
            transform: scale(1.05);
            opacity: 0.9;
        }

        /* Section contenant le texte */
        .p-4 {
            padding: 30px;
            font-family: 'Poppins', sans-serif;
            position: relative;
            z-index: 2;
            transition: background-color 0.3s ease;
            text-align: center;
        }

        .col-md-6:hover .p-4 {
            background-color: #f9f9f9;
        }

        /* Date et auteur */
        .p-4 span {
            font-size: 14px;
            color: #777;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .p-4 p {
            font-size: 16px;
            color: #444;
            margin-top: 15px;
            text-align: justify;
            line-height: 1.5;
        }

        /* Vidéo */
        video {
            border-radius: 15px;
            margin-top: 20px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
            transition: transform 0.3s ease;
            width: 100%;
        }

        .col-md-6:hover video {
            transform: scale(1.05);
        }

        /* Boutons "Voir plus", "Editer", "Supprimer" */
        .btn-primary, .btn-warning, .btn-danger {
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 1px;
            border-radius: 5px;
            padding: 12px 24px;
            transition: background 0.3s ease;
        }

        .btn-primary {
            background: linear-gradient(135deg, #4e73df, #1e3d8f);
            color: white;
        }

        .btn-primary:hover {
            background: linear-gradient(135deg, #1e3d8f, #4e73df);
        }

        .btn-warning {
            background: linear-gradient(135deg, #f39c12, #e67e22);
            color: white;
        }

        .btn-warning:hover {
            background: linear-gradient(135deg, #e67e22, #f39c12);
        }

        .btn-danger {
            background: linear-gradient(135deg, #e74a3b, #c0392b);
            color: white;
        }

        .btn-danger:hover {
            background: linear-gradient(135deg, #c0392b, #e74a3b);
        }

        /* Effet de zoom pour les vidéos et images */
        video:hover,
        .img-fluid:hover {
            transform: scale(1.1);
        }
    </style>
{% endblock %}

{% block body %}
<div class="site-wrap">

    <div class="container">
        <!-- Ajouter un vlog -->
        <a href="{{ path('vlog_new') }}" class="btn btn-success mb-3">
            <i class="fas fa-plus-circle"></i>
        </a>
    </div>

    <div class="site-section">
        <div class="container">
            <div class="row">
                {% for vlog in vlogs %}
                    {% if vlog.author == app.user %}
                        <div class="col-md-6 col-lg-4 mb-4" data-aos="fade-up">
                            <a href="{{ path('vlog_show', {'id': vlog.id}) }}">
                                <!-- Affichage de l'image -->
                                {% if vlog.image %}
                                    <div class="mb-4">
                                        <img src="{{ asset('uploads/images/vlogs/' ~ vlog.image) }}" alt="Image" class="img-fluid">
                                    </div>
                                {% endif %}
                            </a>
                            <div class="p-4 bg-white">
                                <span class="d-block text-secondary small text-uppercase">{{ vlog.createdAt|date("M d, Y") }}</span>
                                <!-- Affichage du nom de l'auteur -->
                                <span class="d-block text-secondary small text-uppercase">Publié par : {{ vlog.author.username }}</span>
                                <p>{{ vlog.content|slice(0, 100) }}...</p> <!-- Affiche un extrait du contenu -->
                                {% if vlog.video %}
                                    <video width="100%" controls>
                                        <source src="{{ asset('uploads/vlogs/' ~ vlog.video) }}" type="video/mp4">
                                        Votre navigateur ne supporte pas la lecture de vidéos.
                                    </video>
                                {% endif %}
                                <div class="mt-3">
                                    <!-- Voir plus -->
                                    <a href="{{ path('vlog_show', {'id': vlog.id}) }}" class="btn btn-primary btn-sm">
                                        <i class="fas fa-eye"></i>
                                    </a>

                                    <!-- Editer -->
                                    <a href="{{ path('vlog_edit', {'id': vlog.id}) }}" class="btn btn-warning btn-sm">
                                        <i class="fas fa-edit"></i>
                                    </a>

                                    <!-- Supprimer -->
                                    <form action="{{ path('vlog_delete', {'id': vlog.id}) }}" method="POST" style="display:inline;">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ vlog.id) }}">
                                        <input type="hidden" name="_method" value="DELETE">  <!-- Simule la méthode DELETE -->
                                        <button type="submit" class="btn btn-danger btn-sm">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    {% endif %}
                {% endfor %}
            </div>
        </div>
    </div>

</div>
{% endblock %}
