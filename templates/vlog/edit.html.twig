{% extends 'page/index.html.twig' %}

{% block body %}


    <div class="site-section">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-md-8">
                    <h2 class="mb-4 text-center">Modifier le Vlog</h2>

                    {{ form_start(form) }}
                    
                    <div class="form-group mb-4">
                        <label for="form_content" class="font-weight-bold">Contenu du Vlog</label>
                        {{ form_row(form.content, {'attr': {'class': 'form-control', 'placeholder': 'Entrez le contenu de votre vlog', 'rows': 5}}) }}
                    </div>

                    {# Affichage de l'image actuelle si elle existe #}
                    {% if vlog.image %}
                        <div class="form-group">
                            <label>Image actuelle :</label>
                            <img src="{{ asset('uploads/images/' ~ vlog.image) }}" alt="Image actuelle" class="img-fluid" width="200"/>
                        </div>
                    {% endif %}

                    <div class="form-group mb-4">
                        <label for="form_image" class="font-weight-bold">Image (optionnelle)</label>
                        {{ form_row(form.image, {'attr': {'class': 'form-control-file', 'accept': 'image/*'}}) }}
                        <small class="form-text text-muted">Formats acceptés: jpg, jpeg, png, gif.</small>
                    </div>

                    <div class="form-group mb-4">
                        <label for="form_video" class="font-weight-bold">Vidéo (optionnelle)</label>
                        {{ form_row(form.video, {'attr': {'class': 'form-control-file', 'accept': 'video/*'}}) }}
                        <small class="form-text text-muted">Formats acceptés: mp4, avi, mov, mkv.</small>
                    </div>

                    <div class="form-group text-center">
                        <button class="btn btn-primary px-5 py-3" type="submit">Mettre à jour</button>
                    </div>

                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
