{% extends 'base.html.twig' %}

{% block title %}New Reservation{% endblock %}

{% block body %}
<div class="container mt-5">
    <h1 class="mb-4">Create a New Reservation</h1>
    
    {% for flash_message in app.session.flashbag.get('error') %}
        <div class="alert alert-danger">{{ flash_message }}</div>
    {% endfor %}

    <div class="mb-3">
        {{ form_start(form) }}
        <div class="form-group">
            {{ form_label(form.start_date) }}
            {{ form_widget(form.start_date, { 'attr': {'class': 'form-control'} }) }}
        </div>
        <div class="form-group">
            {{ form_label(form.end_date) }}
            {{ form_widget(form.end_date, { 'attr': {'class': 'form-control'} }) }}
        </div>
        <div class="form-group">
            {{ form_label(form.transport_id) }}
            {{ form_widget(form.transport_id, { 'attr': {'class': 'form-control'} }) }}
        </div>
        <div class="form-group">
            {{ form_label(form.statut) }}
            {{ form_widget(form.statut, { 'attr': {'class': 'form-control'} }) }}
        </div>
        <button type="submit" class="btn btn-primary">Reserve</button>
        {{ form_end(form) }}
    </div>
    <a href="{{ path('app_reservation_transport_index') }}" class="btn btn-secondary">Back to list</a>
</div>
{% endblock %}
